@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject SimulatorState State

@foreach (var group in Snapshot.Rooms.Select(room => (Group: room, Type: "Room"))
             .Concat(Snapshot.Zones.Select(zone => (Group: zone, Type: "Zone"))))
{
    <section class="room">
        <header class="group-heading">
            <span class="group-type">@group.Type</span>
            <h2>@group.Group.Name</h2>
        </header>
        <div class="lights">
            @foreach (var light in Snapshot.Lights.Where(light => group.Group.LightIds.Contains(light.Id)))
            {
                <article class="light @(light.IsOn ? "on" : "off")"
                         style="--light-color: @ToCssColor(light.Color); --light-brightness: @ToCssPercentage(light.Brightness)">
                    <h3>@light.Name</h3>
                    <p class="light-status">
                        @ColorName(light.Color) · @Math.Round(light.Brightness)%
                    </p>
                    <div class="actions">
                        <button @onclick="() => SetPower(light.Id, !light.IsOn)">Turn @(light.IsOn ? "off" : "on")</button>
                        <input aria-label="@light.Name brightness" type="range" min="1" max="100" value="@light.Brightness"
                               @onchange="args => SetBrightness(light.Id, args.Value)" />
                    </div>
                    <div class="palette" aria-label="@light.Name color">
                        @foreach (var color in Palette)
                        {
                            <button class="swatch @(Matches(light.Color, color.Value) ? "selected" : "")"
                                    style="--swatch: @color.Css" title="@color.Name" aria-label="Set @light.Name to @color.Name"
                                    @onclick="() => SetColor(light.Id, color.Value)"></button>
                        }
                    </div>
                </article>
            }
        </div>
    </section>
}

<section class="room">
    <h2>Scenes</h2>
    <div class="actions">
        @foreach (var scene in Snapshot.Scenes)
        {
            <button @onclick="() => ActivateScene(scene.Id)">@scene.Name</button>
        }
    </div>
</section>

@code {
    private SimulatorSnapshot Snapshot { get; set; } = default!;
    private readonly CancellationTokenSource _dispose = new();
    private static readonly ColorOption[] Palette =
    [
        new("Red", new HueColor(.675, .322), "#ef4444"),
        new("Orange", new HueColor(.550, .410), "#f97316"),
        new("Yellow", new HueColor(.443, .515), "#eab308"),
        new("Green", new HueColor(.214, .709), "#22c55e"),
        new("Cyan", new HueColor(.170, .340), "#06b6d4"),
        new("Blue", new HueColor(.150, .060), "#3b82f6"),
        new("Purple", new HueColor(.382, .160), "#8b5cf6"),
        new("Pink", new HueColor(.458, .181), "#ec4899"),
        new("White", new HueColor(.323, .329), "#f8fafc"),
        new("Warm white", new HueColor(.458, .410), "#ffd6a1"),
        new("Cool white", new HueColor(.313, .323), "#d6e8ff")
    ];

    protected override void OnInitialized()
    {
        Snapshot = State.GetSnapshot();
        _ = RefreshAsync();
    }

    private void SetPower(Guid id, bool on)
    {
        State.UpdateLight(id, new LightUpdateRequest(on, null, null));
        Snapshot = State.GetSnapshot();
    }

    private void SetBrightness(Guid id, object? value)
    {
        if (double.TryParse(value?.ToString(), out var brightness))
        {
            State.UpdateLight(id, new LightUpdateRequest(null, brightness, null));
            Snapshot = State.GetSnapshot();
        }
    }

    private void SetColor(Guid id, HueColor color)
    {
        State.UpdateLight(id, new LightUpdateRequest(null, null, color));
        Snapshot = State.GetSnapshot();
    }

    private static bool Matches(HueColor? current, HueColor candidate) =>
        current is not null && Math.Abs(current.X - candidate.X) < .001 && Math.Abs(current.Y - candidate.Y) < .001;

    private static string ColorName(HueColor? color) => Palette.FirstOrDefault(option => Matches(color, option.Value))?.Name ?? "Custom";

    private static string ToCssColor(HueColor? color) => Palette.FirstOrDefault(option => Matches(color, option.Value))?.Css ?? "#94a3b8";

    private static string ToCssPercentage(double brightness) => $"{brightness:0.##}%";

    private void ActivateScene(Guid id)
    {
        State.ActivateScene(id);
        Snapshot = State.GetSnapshot();
    }

    private async Task RefreshAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_dispose.Token))
            {
                Snapshot = State.GetSnapshot();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose() => _dispose.Cancel();

    private sealed record ColorOption(string Name, HueColor Value, string Css);
}
