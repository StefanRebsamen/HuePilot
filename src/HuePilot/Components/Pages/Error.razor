@page "/Error"
@using System.Diagnostics

<PageTitle>Error · HuePilot</PageTitle>

<main class="setup-shell">
    <section class="resource-error">
        <h1>Something went wrong</h1>
        <p>HuePilot could not complete that page request. Return to the chat and try again.</p>
        @if (ShowRequestId)
        {
            <p><strong>Request ID:</strong> <code>@RequestId</code></p>
        }
        <a href="/">Back to HuePilot</a>
    </section>
</main>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
